<?xml version="1.0" encoding="utf-8"?>
<!--
    The auto-off button in the compact controls. Hand-drawn rather than taken from
    material-icons-extended: that artifact is thousands of vectors and this project deliberately
    depends on material-icons-core only (gradle/libs.versions.toml), which has no clock in it.

    Strokes rather than a filled silhouette, because the geometry is then something a reader can
    check: a circle of radius 8 centred at (12,13), a crown bar across the top, and two hands.
    Compose's `Icon` tints the painter, so the colours here only have to be opaque.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M9,3 L15,3"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M4,13 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeColor="#FF000000"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12,13 L12,8.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12,13 L15.5,13"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
</vector>
