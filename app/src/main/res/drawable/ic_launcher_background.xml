<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's back layer: the app's night with the amber banked low, which is the same
  horizon art/make-feature-graphic.py draws. Generated by art/make-launcher-icon.py from
  mark.ground() — regenerate rather than editing the stops here.

  A themed launcher (API 33+) ignores this layer entirely and tints the monochrome one flat, so
  the gradient is what a *standard* icon shows and nothing here is load-bearing for theming.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="54"
          android:centerY="110.16"
          android:gradientRadius="91.8">
          <item android:offset="0" android:color="#BF752C" />
          <item android:offset="0.125" android:color="#A06327" />
          <item android:offset="0.25" android:color="#835322" />
          <item android:offset="0.375" android:color="#69431D" />
          <item android:offset="0.5" android:color="#513619" />
          <item android:offset="0.625" android:color="#3C2915" />
          <item android:offset="0.75" android:color="#2A1F12" />
          <item android:offset="0.875" android:color="#1D170F" />
          <item android:offset="1" android:color="#15130E" />
      </gradient>
    </aapt:attr>
  </path>
</vector>
