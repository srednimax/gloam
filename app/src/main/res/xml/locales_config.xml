<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages this app ships in. English is the base and the fallback for every unmatched
    locale.

    Android 13+ reads this list to build the app's entry in Settings › Apps › <app> › Language.
    Below 13 the platform has no such screen and AppCompat's backport reads the same list.

    It is also what the platform checks before honouring `setApplicationLocales()`: on 13+ an app
    locale outside this list is declined outright. Every entry here needs a matching `AppLanguage`
    constant — `AppLanguageTest` parses this file and asserts the two agree — and a matching
    `res/values-<tag>/strings.xml`, which `scripts/translation-gate.py` requires to be complete
    before a branch may merge.

    **Adding a locale here is the whole opt-in.** Do it when the translation is ready, not before:
    an entry with no strings behind it offers the user a language the app cannot speak.

    **Seven of these nine ship without a native speaker having read them** — every entry below except
    `en` and `pl`. That is a decision rather than an omission, and what stands in for the read-through
    is an audit of the copy that makes safety claims plus the report row under the picker:
    [ADR-0014](../../../../../docs/adr/0014-a-language-ships-on-an-audit-not-a-native-read-through.md).
    A tenth language takes the same path.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pl" />
    <locale android:name="cs" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="it" />
    <locale android:name="pt-BR" />
    <locale android:name="uk" />
</locale-config>
