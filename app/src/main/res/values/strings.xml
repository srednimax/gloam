<?xml version="1.0" encoding="utf-8"?>
<!--
    The base language. **Every user-visible string lives here**, never as a literal in Kotlin — that
    is what makes the app translatable at all, and `TranslationTest` is what keeps it true.

    Two rules with teeth:

    - A string with a format argument must carry the **same arguments in every locale**, and
      positional (`%1$s`) rather than bare (`%s`) whenever there is more than one, so a translator
      can reorder them. `TranslationTest` checks this continuously.
    - A count-dependent string is a `<plurals>`, never string concatenation. The categories that
      apply differ by language — Polish has `one`, `few`, `many`, `other` where English has two —
      and CLDR decides which, not the translator.

    `translatable="false"` marks a string that is deliberately identical everywhere: the app's own
    name, and the language endonyms in the switcher, which are named in their own language on
    purpose so someone lost in a language they cannot read can find their way back.
-->
<resources>
    <string name="app_name" translatable="false">Gloam</string>

    <!-- Navigation -->
    <string name="tab_dim">Dim</string>
    <string name="tab_settings">Settings</string>

    <!-- Common actions -->
    <string name="action_back">Back</string>

    <!-- The dim screen. "Dim level" rather than "brightness" throughout, per CONTEXT.md: the
         backlight is Android's value and this one runs the other way. -->
    <string name="dim_title">Dim</string>
    <string name="dim_level_label">Dim level</string>
    <string name="dim_level_value">%1$d%%</string>
    <string name="dim_start">Start dimming</string>
    <string name="dim_stop">Stop dimming</string>
    <string name="dim_permission_title">Gloam needs permission to draw over other apps</string>
    <string name="dim_permission_body">The shade is a layer on top of whatever is on screen, so Android asks you to allow it explicitly. Gloam reads nothing about the apps underneath. When you start dimming it will also ask to show a notification — that notification is how you stop Gloam from anywhere.</string>
    <string name="dim_permission_grant">Open settings</string>

    <!-- The escape-hatch warning. It makes a safety claim — that there is a Stop button outside the
         app — so it names the consequence rather than the permission. -->
    <string name="dim_notification_warning_title">No Stop button outside Gloam</string>
    <string name="dim_notification_warning_body">Gloam is allowed to dim your screen but not to show a notification, so the only way to stop it is this screen.</string>
    <string name="dim_notification_warning_channel_body">Gloam\'s notification is switched off, so the only way to stop dimming is this screen.</string>
    <string name="dim_notification_warning_ask">Allow notifications</string>
    <string name="dim_notification_warning_settings">Open notification settings</string>

    <!-- The backlight toggle. The hint says the inert brightness slider out loud, because the
         symptom recurs and a user who meets it with no explanation reports that Gloam broke their
         phone. The unavailable line replaces the promise on a device that cannot keep it. -->
    <string name="dim_backlight_label">Also lower the screen brightness</string>
    <string name="dim_backlight_hint">Takes your screen\'s own brightness down to its lowest before the shade starts, so Gloam has less light to cover. While it is on, your phone\'s brightness slider will not do anything until you stop dimming.</string>
    <string name="dim_backlight_unavailable">This phone does not report its brightness in a way Gloam can use, so Gloam dims by drawing over the screen only.</string>

    <!-- Auto-off (CONTEXT.md). It cannot be switched "off" — "off" is reserved for the shade not
         being drawn, so the choice that disables it is Never. The hint says what the feature buys
         rather than what it does: the failure being designed out is a phone dimmed at midnight and
         still dark at breakfast. "Turns off at 23:40" is a clock time formatted by the platform,
         never a countdown built out of words. -->
    <string name="dim_auto_off_label">Turn off on its own</string>
    <string name="dim_auto_off_never">Never</string>
    <string name="dim_auto_off_30m">After 30 minutes</string>
    <string name="dim_auto_off_1h">After 1 hour</string>
    <string name="dim_auto_off_2h">After 2 hours</string>
    <string name="dim_auto_off_4h">After 4 hours</string>
    <string name="dim_auto_off_hint">Gloam takes the shade down by itself after this long, so a screen you dimmed and forgot about is not still dark tomorrow.</string>
    <!-- %1$s is a time of day, formatted for the phone's own locale and 12/24-hour setting. -->
    <string name="dim_auto_off_at">Turns off at %1$s</string>

    <!-- The warmth slider. "Warmth" per CONTEXT.md: not "night mode" — that is the app's own dark
         theme — and not any wording about filtering or cutting blue light, which an overlay cannot
         do. It adds amber over an already-dark screen. -->
    <string name="dim_warmth_label">Warmth</string>

    <!-- Settings -->
    <string name="settings_appearance">Appearance</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_material_you">Use my wallpaper colours</string>
    <string name="settings_material_you_hint">Android 12 and later. Off by default, so the app keeps its own palette.</string>
    <string name="settings_language">Language</string>
    <string name="settings_language_system">System</string>
    <string name="settings_language_english" translatable="false">English</string>
    <string name="settings_language_polish" translatable="false">Polski</string>
    <!-- Reboot restore, and the hand-off to Xiaomi's autostart screen. Shown only where that
         screen exists, which is what lets the second sentence say "this phone" — nobody whose
         phone has no such setting ever reads it. It promises nothing about the outcome: the app
         cannot read that setting back, and the honest thing is to name where to look rather than
         to report a state it is guessing at. -->
    <string name="settings_restart">After a restart</string>
    <string name="settings_restart_body">Gloam puts the shade back when your phone restarts. This phone only lets an app run at startup if autostart is switched on for it, and Gloam has no way to check whether it is — so if the shade does not come back, this is the setting to look at.</string>
    <string name="settings_restart_open">Open autostart settings</string>

    <string name="settings_about">About</string>
    <string name="settings_licences">Open-source licences</string>

    <!-- Licences -->
    <string name="licence_text_missing">The text of this licence is not bundled with the app.</string>

    <!-- Notification channels. The convention `channel_<id>_name` / `channel_<id>_description` is
         asserted by ReminderChannelsTest, so a new channel cannot ship with no name. -->
    <string name="channel_shade_name">Dimming</string>
    <string name="channel_shade_description">Shown while the screen is dimmed, so the shade can be turned off from anywhere.</string>
    <string name="shade_notification_title">Screen dimmed</string>
    <string name="shade_notification_stop">Stop</string>
</resources>
